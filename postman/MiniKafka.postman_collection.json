{
  "info": {
    "name": "MiniKafka",
    "description": "REST API of MiniKafka. Start the app (mvn spring-boot:run), then run the folders in order. X-Client-Id is what shows up as 'actor' in logs/audit.log.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "topic",
      "value": "orders"
    },
    {
      "key": "group",
      "value": "billing"
    }
  ],
  "item": [
    {
      "name": "1. Produce (added by whom)",
      "item": [
        {
          "name": "Produce as order-service (key alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "order-service"
              },
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topic}}/messages?key=alice",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topic}}",
                "messages"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "alice"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "deposit"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"has partition and offset\", () => { pm.expect(b.partition).to.be.within(0, 3); pm.expect(b.offset).to.be.at.least(0); });",
                  "pm.collectionVariables.set(\"lastPartition\", b.partition);",
                  "pm.collectionVariables.set(\"lastOffset\", b.offset);"
                ]
              }
            }
          ]
        },
        {
          "name": "Produce as order-service (same key -> same partition)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "order-service"
              },
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topic}}/messages?key=alice",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topic}}",
                "messages"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "alice"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "withdraw"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"same partition as before\", () => pm.expect(pm.response.json().partition).to.eql(Number(pm.collectionVariables.get(\"lastPartition\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Produce as payment-service (key bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "payment-service"
              },
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topic}}/messages?key=bob",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topic}}",
                "messages"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "bob"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "payment received"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Produce without a client id (shows as anonymous)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topic}}/messages?key=carol",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topic}}",
                "messages"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "carol"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "hello"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
